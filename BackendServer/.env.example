# Copy this file to .env for local development. Never commit the real .env file.
FIREBASE_STORAGE_BUCKET=your-project.appspot.com
FIREBASE_WEB_API_KEY=your-firebase-web-api-key
GOOGLE_APPLICATION_CREDENTIALS=/absolute/path/to/service-account.json
# Managed runtimes can inject the same credential as one JSON secret instead.
# Do not configure both credential variables at the same time.
# FIREBASE_SERVICE_ACCOUNT_JSON={"type":"service_account",...}
OPENAI_API_KEY=your-openai-api-key
# OpenAI API models are metered rather than free. This is the current low-cost default.
OPENAI_MODEL=gpt-5.4-nano
OPENAI_REASONING_EFFORT=low
SAFETY_IDENTIFIER_SALT=replace-with-a-long-random-secret

# Production should use HTTPS. This value is used only for documentation/configuration.
PUBLIC_API_URL=https://api.example.com

# AWS asynchronous job backend. Use deployment-specific names, never account keys.
AWS_REGION=us-east-1
UPLOAD_BUCKET=your-private-video-upload-bucket
JOBS_TABLE=sharp-shooter-jobs
# Keep the lease longer than the worker Lambda timeout, with a safety margin.
PROCESSING_LEASE_SECONDS=960
MAX_PROCESSING_ATTEMPTS=3
